// Memory.hdl - Hack data memory (Nand to Tetris, Project 5)
// 0-16383: RAM16K, 16384-24575: Screen, 24576: Keyboard.
// Uses built-in RAM16K, Screen, Keyboard, DMux4Way, Mux4Way16.

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14..13]: 00,01 -> RAM16K ; 10 -> Screen ; 11 -> Keyboard
    DMux4Way(in=load, sel=address[13..14], a=ramA, b=ramB, c=screenLoad, d=kbdLoad);
    Or(a=ramA, b=ramB, out=ramLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}

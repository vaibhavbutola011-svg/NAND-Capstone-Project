// CPU.hdl - Hack CPU (Nand to Tetris, Project 5)
// Built only from built-in chips: Mux16, Not, And, Or, ARegister, DRegister, ALU, PC.
// NOTE: built-in versions of these chips are used (not my own earlier lab chips).

CHIP CPU {
    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current program

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
    // instruction[15] = 1 -> C-instruction, 0 -> A-instruction
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=true, out=isC);

    // A register input: instruction itself (A-instr) or ALU output (C-instr with dest A)
    Mux16(a=instruction, b=aluOut, sel=isC, out=aIn);

    // dest bits: instruction[5]=A, [4]=D, [3]=M
    And(a=isC, b=instruction[5], out=destA);
    Or(a=isA, b=destA, out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // a bit (instruction[12]) selects A or M as ALU's second operand
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aOrM);

    And(a=isC, b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    ALU(x=dOut, y=aOrM,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    And(a=isC, b=instruction[3], out=writeM);

    // Jump logic: j1=instruction[2] (<0), j2=[1] (=0), j3=[0] (>0)
    Or(a=zr, b=ng, out=zrOrNg);
    Not(in=zrOrNg, out=pos);
    And(a=instruction[2], b=ng,  out=jlt);
    And(a=instruction[1], b=zr,  out=jeq);
    And(a=instruction[0], b=pos, out=jgt);
    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jmpCond);
    And(a=isC, b=jmpCond, out=doJump);

    PC(in=aOut, load=doJump, inc=true, reset=reset, out[0..14]=pc);
}
